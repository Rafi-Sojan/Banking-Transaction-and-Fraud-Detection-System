digraph BankingFraudER {
    graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=1.0, bgcolor="white"];
    node [fontname="Arial", fontsize=10];
    edge [fontname="Arial", fontsize=9];

    // Chen notation: entities=rectangles, attributes=ellipses, relationships=diamonds.
    customer [shape=box, label="CUSTOMER"];
    account [shape=box, label="ACCOUNT"];
    branch [shape=box, label="BRANCH"];
    card [shape=box, label="CARD"];
    merchant [shape=box, label="MERCHANT"];
    category [shape=box, label="MERCHANT_CATEGORY"];
    location [shape=box, label="LOCATION"];
    transaction [shape=box, label="TRANSACTIONS"];
    app_user [shape=box, label="APP_USER"];
    role [shape=box, label="ROLE"];
    alert [shape=box, label="FRAUD_ALERT"];
    rule [shape=box, label="FRAUD_RULE"];
    rule_result [shape=box, label="FRAUD_RULE_RESULT"];
    model [shape=box, label="ML_MODEL"];
    investigation [shape=box, label="INVESTIGATION"];
    action [shape=box, label="INVESTIGATION_ACTION"];
    audit [shape=box, label="AUDIT_LOG"];

    customer_id [shape=ellipse, label="PK customer_id"];
    account_id [shape=ellipse, label="PK account_id"];
    account_number [shape=ellipse, label="account_number UNIQUE"];
    branch_id [shape=ellipse, label="PK branch_id"];
    card_id [shape=ellipse, label="PK card_id"];
    merchant_id [shape=ellipse, label="PK merchant_id"];
    category_id [shape=ellipse, label="PK category_id"];
    location_id [shape=ellipse, label="PK location_id"];
    transaction_id [shape=ellipse, label="PK transaction_id"];
    user_id [shape=ellipse, label="PK user_id"];
    role_id [shape=ellipse, label="PK role_id"];
    alert_id [shape=ellipse, label="PK alert_id"];
    rule_id [shape=ellipse, label="PK rule_id"];
    rule_result_id [shape=ellipse, label="PK rule_result_id"];
    model_id [shape=ellipse, label="PK model_id"];
    investigation_id [shape=ellipse, label="PK investigation_id"];
    action_id [shape=ellipse, label="PK action_id"];
    audit_id [shape=ellipse, label="PK audit_id"];

    owns [shape=diamond, label="OWNS"];
    maintains [shape=diamond, label="MAINTAINS"];
    issues [shape=diamond, label="HAS"];
    classifies [shape=diamond, label="CLASSIFIES"];
    located [shape=diamond, label="LOCATED_AT"];
    originates [shape=diamond, label="ORIGINATES"];
    receives [shape=diamond, label="RECEIVES"];
    uses [shape=diamond, label="USES"];
    assigned [shape=diamond, label="ASSIGNED_TO"];
    produces [shape=diamond, label="PRODUCES"];
    has_rule_results [shape=diamond, label="HAS_RULE_RESULTS"];
    triggers [shape=diamond, label="TRIGGERS"];
    scores [shape=diamond, label="SCORES"];
    has_investigation [shape=diamond, label="HAS_INVESTIGATION"];
    has_actions [shape=diamond, label="HAS_ACTIONS"];
    performs [shape=diamond, label="PERFORMS"];
    writes [shape=diamond, label="WRITES"];

    customer -- customer_id [label="PK"];
    account -- account_id [label="PK"];
    account -- account_number;
    branch -- branch_id [label="PK"];
    card -- card_id [label="PK"];
    merchant -- merchant_id [label="PK"];
    category -- category_id [label="PK"];
    location -- location_id [label="PK"];
    transaction -- transaction_id [label="PK"];
    app_user -- user_id [label="PK"];
    role -- role_id [label="PK"];
    alert -- alert_id [label="PK"];
    rule -- rule_id [label="PK"];
    rule_result -- rule_result_id [label="PK"];
    model -- model_id [label="PK"];
    investigation -- investigation_id [label="PK"];
    action -- action_id [label="PK"];
    audit -- audit_id [label="PK"];

    customer -- owns [label="1"];
    owns -- account [label="M"];
    branch -- maintains [label="1"];
    maintains -- account [label="M"];
    account -- issues [label="1"];
    issues -- card [label="M"];
    category -- classifies [label="1"];
    classifies -- merchant [label="M"];
    location -- located [label="1"];
    located -- merchant [label="M"];
    account -- originates [label="1"];
    originates -- transaction [label="M"];
    account -- receives [label="1"];
    receives -- transaction [label="M"];
    card -- uses [label="0..1"];
    uses -- transaction [label="M"];
    transaction -- produces [label="1"];
    produces -- alert [label="M"];
    alert -- has_rule_results [label="1"];
    has_rule_results -- rule_result [label="M"];
    rule -- triggers [label="1"];
    triggers -- rule_result [label="M"];
    model -- scores [label="1"];
    scores -- alert [label="M"];
    alert -- has_investigation [label="1"];
    has_investigation -- investigation [label="M"];
    investigation -- has_actions [label="1"];
    has_actions -- action [label="M"];
    app_user -- performs [label="1"];
    performs -- action [label="M"];
    role -- assigned [label="1"];
    assigned -- app_user [label="M"];
    app_user -- writes [label="1"];
    writes -- audit [label="M"];
}
